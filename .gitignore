# .gitignore for Academic Decision Assistant

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual Environment
venv/
.venv/
env/

# Environment variables

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Model caches (large files)
.cache/
models/

# Test & Coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Alembic
alembic/versions/*.pyc

# Logs
*.log
logs/
