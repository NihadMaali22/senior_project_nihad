# ============================================================
# Decision-Making Academic Assistant — Environment Variables
# ============================================================

# --- Application ---
APP_NAME=Academic Decision Assistant
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=academic_user
POSTGRES_PASSWORD=academic_pass_2024
POSTGRES_DB=academic_db
DATABASE_URL=postgresql+asyncpg://academic_user:academic_pass_2024@localhost:5432/academic_db

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=university_regulations
QDRANT_GRPC_PORT=6334

# --- Ollama (Local LLM) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT=120

# --- Gemini API ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=90

# --- Groq API ---
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b

# --- Embedding Models ---
DENSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DENSE_EMBEDDING_DIM=384
SPARSE_EMBEDDING_MODEL=prithivida/Splade_PP_en_v1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Settings ---
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_SPLIT_BY=sentence
RAG_SPLIT_LENGTH=5
RAG_SPLIT_OVERLAP=1

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
